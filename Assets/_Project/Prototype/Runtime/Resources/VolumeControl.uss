.volume-control {
    margin: 4px 0 16px;
    padding: 10px 14px;
    background-color: #112238;
    border-color: #3bc0b7;
    border-width: 2px;
    border-radius: 5px;
    color: #ffedbd;
}

.volume-control .volume-label {
    margin: 0 0 5px;
    font-size: 14px;
}

.volume-control .unity-base-slider {
    margin: 0;
    min-height: 28px;
}

.volume-control .unity-base-slider__tracker {
    height: 6px;
    background-color: #2b546a;
    border-width: 0;
}

.volume-control .unity-base-slider__dragger {
    width: 14px;
    height: 18px;
    border-width: 2px;
    border-color: #936226;
    border-radius: 3px;
    background-color: #ffbd3a;
}

.volume-control .unity-base-slider:focus .unity-base-slider__dragger {
    border-color: #fff0c9;
}
